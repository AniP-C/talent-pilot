# Copy this file to .env and fill in your own values.

# --- Required -------------------------------------------------------------
# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Hosting (see DEPLOYMENT.md) ------------------------------------------
# Public HTTPS base URL. Setting this switches Gmail to the redirect OAuth
# flow, which is the only one that works on a server.
# PUBLIC_URL=https://jobs.yourdomain.com

# Registration control. Set SIGNUP_CODE before exposing this to the internet,
# or nobody stops strangers signing up and spending your Gemini quota.
# SIGNUP_CODE=
# REGISTRATION_CLOSED=false

# Only "true" when a reverse proxy you control sits in front. X-Forwarded-For
# is client-settable, so trusting it on a direct server defeats rate limiting.
# TRUST_PROXY_HEADERS=false

# MAX_LOGIN_ATTEMPTS=10
# LOGIN_LOCKOUT_MINUTES=15

# --- Optional -------------------------------------------------------------
# Gemini model used for all analysis and drafting.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Where account and workspace data is stored (defaults to ./data).
# DATA_DIR=
# LOG_DIR=

# API server binding and the dashboard URL the extension opens.
# API_HOST=127.0.0.1
# API_PORT=8000
# DASHBOARD_URL=http://localhost:8501

# Origins allowed to call the API. The default accepts Chrome extensions only,
# which keeps ordinary web pages from reaching the local server.
# ALLOWED_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$

# How long an issued API token stays valid, in days.
# TOKEN_TTL_DAYS=30

# Gmail sync tuning.
# GMAIL_MAX_RESULTS=25
# GMAIL_LOOKBACK_DAYS=5
# GMAIL_THROTTLE_SECONDS=4
# GMAIL_CREDENTIALS_PATH=credentials.json

# LOG_LEVEL=INFO
