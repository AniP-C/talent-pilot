{
  "manifest_version": 3,
  "name": "Talent Pilot — AI Job Copilot",
  "version": "2.1.0",
  "description": "Save job postings, score them against your resume, and reuse your saved application answers.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://katchjobs.online/*",
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Talent Pilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.wellfound.com/*",
        "https://*.angel.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.workable.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
