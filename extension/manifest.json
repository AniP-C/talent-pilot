{
  "manifest_version": 3,
  "name": "Talent Pilot \u2014 AI Job Copilot",
  "version": "2.6.0",
  "description": "See how a job matches your resume as you open it, save it in one click, and reuse your saved application answers.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://katchjobs.online/*",
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Talent Pilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.wellfound.com/*",
        "https://*.angel.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.workable.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.icims.com/*",
        "https://*.jobvite.com/*",
        "https://*.bamboohr.com/*",
        "https://*.breezy.hr/*",
        "https://*.recruitee.com/*",
        "https://*.teamtailor.com/*",
        "https://*.applytojob.com/*",
        "https://*.zohorecruit.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://*.workatastartup.com/*",
        "https://*.pinpointhq.com/*",
        "https://*.naukri.com/*",
        "https://*.indeed.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
