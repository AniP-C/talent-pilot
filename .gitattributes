# Normalise line endings so files behave the same on every checkout.
* text=auto

# These are consumed by Linux and MUST keep LF endings. A shell script with
# CRLF fails at the shebang with "bad interpreter: bash^M", and systemd
# refuses unit files with carriage returns.
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
Caddyfile       text eol=lf
Dockerfile      text eol=lf
docker-compose.yml text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.pdf binary
*.db  binary
