# Talent Pilot reverse proxy.
#
# Replace YOUR_DOMAIN below, then copy to /etc/caddy/Caddyfile.
# Caddy obtains and renews the TLS certificate automatically.
#
# One hostname serves both processes: API paths go to uvicorn on 8000,
# everything else falls through to Streamlit on 8501.

YOUR_DOMAIN {
	encode gzip

	# ---- API routes (FastAPI on 8000) --------------------------------
	# Listed explicitly so a future dashboard page can never shadow one.
	# EVERY new API endpoint must be added here. A path missing from this list
	# does not 404 — it falls through to the dashboard, which answers 200 with
	# an HTML page, so the extension sees a success it cannot parse. That is a
	# much harder failure to read than a 404.
	@api path /health* /auth/* /jobs* /profiles* /check-job* /save-job* /analyze-job* /generate-answer* /save-answer* /autofill* /privacy* /docs* /openapi.json
	handle @api {
		reverse_proxy 127.0.0.1:8000
	}

	# ---- Dashboard (Streamlit on 8501) -------------------------------
	handle {
		# Streamlit needs its websocket upgraded for the UI to work at all.
		reverse_proxy 127.0.0.1:8501 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Caddy sets X-Forwarded-For itself, overwriting anything the client
	# sent. That is what makes TRUST_PROXY_HEADERS=true safe here.

	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Access logs go to journald, readable with `journalctl -u caddy`.
	#
	# Deliberately NOT logging to a file: Caddy's packaged systemd unit is
	# sandboxed such that it cannot open a writer under /var/log/caddy even
	# when that directory is owned by the caddy user, and the resulting
	# "permission denied" stops Caddy from starting at all.
}

# ---------------------------------------------------------------------
# No domain yet? Comment out the block above and uncomment this one.
# Serves plain HTTP on the server's IP.
#
# Gmail sync will NOT work in this mode — Google requires an HTTPS
# redirect URI and will not accept a bare IP address.
# ---------------------------------------------------------------------
